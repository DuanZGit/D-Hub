[Unit]
Description=d-hub Multi-Agent Coordination Layer
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=duanz
WorkingDirectory=/opt/d-hub
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/d-hub/config/dhub.env
ExecStart=/opt/d-hub/.venv/bin/python -m dhub
UMask=0077
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/d-hub

[Install]
WantedBy=multi-user.target

# d-hub runtime configuration
DHUB_ROOT=/opt/d-hub
DHUB_HOST=0.0.0.0
DHUB_PORT=10101
DHUB_BACKUP_RETENTION_DAYS=7
DHUB_URL=http://127.0.0.1:10101
# Fresh installs generate DHUB_API_KEY automatically. Set it manually when deploying
# without deploy/install.sh.
# DHUB_API_KEY=
DHUB_MEMORY_BACKEND=json
NEW_API_BASE_URL=http://127.0.0.1:3000/v1
# Until the four values below are configured, memory safely uses JSON fallback.
# NEW_API_KEY=
# DHUB_LLM_MODEL=
# DHUB_EMBED_MODEL=
DHUB_EMBED_DIMS=1536
MEM0_DB_HOST=127.0.0.1
MEM0_DB_PORT=5432
MEM0_DB_NAME=mem0
MEM0_DB_USER=mem0
# MEM0_DB_PASSWORD=

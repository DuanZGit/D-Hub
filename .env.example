# D-Hub 环境变量模板（复制为 .env 并填真实值）
# 本文件只允许出现空值或示例占位符，禁止写入真实 URL / key / 凭据。

# --- 必填：NewAPI 上游（LLM + embedding 都走这里）---
# 填你的 OpenAI 兼容服务地址与 key（占位符，勿提交真实值）
NEW_API_BASE_URL=https://example.invalid/v1
NEW_API_KEY=sk-example-placeholder

# --- LLM（语义同步用）---
DHUB_LLM_MODEL=

# --- Embedding（mem0 向量后端）---
DHUB_EMBED_MODEL=
DHUB_EMBED_DIMS=1536

# --- 记忆后端：mem0（向量）或 json（无向量，降级）---
# 可切换为腾讯 Agent Memory：DHUB_MEMORY_BACKENDS=agent_memory 或
# DHUB_MEMORY_BACKENDS=mem0,agent_memory（显式配置才会启用，升级不自动切换）
DHUB_MEMORY_BACKEND=mem0
DHUB_MEMORY_BACKENDS=

# --- 腾讯 TencentDB Agent Memory adapter（未配置时不阻塞启动）---
DHUB_AGENT_MEMORY_URL=
DHUB_AGENT_MEMORY_API_KEY=
DHUB_AGENT_MEMORY_API_VERSION=
DHUB_AGENT_MEMORY_TIMEOUT_MS=5000
DHUB_AGENT_MEMORY_RETRIES=2
DHUB_AGENT_MEMORY_NAMESPACE=

# --- 记忆双写/双读评测（默认关闭，不改变默认 Mem0 结果）---
DHUB_MEMORY_DUAL_WRITE=false
DHUB_MEMORY_DUAL_READ=false
DHUB_MEMORY_RESULT_LIMIT=10
DHUB_MEMORY_MAX_CHARS=12000

# --- mem0 用的 PostgreSQL（若用 mem0 后端）---
# POSTGRES_URI=postgresql://dhub:password@pgvector:5432/dhub
# PG_PASSWORD=changeme

# --- 鉴权：admin key（不设则鉴权关闭）---
# DHUB_ADMIN_KEY=admin-xxx

# --- 服务配置 ---
DHUB_PORT=10101
DHUB_HOST=0.0.0.0

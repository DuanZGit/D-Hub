# D-Hub Docker 环境变量模板（复制为 .env 并填真实值）

# --- 必填：NewAPI 上游（LLM + embedding 都走这里）---
NEW_API_BASE_URL=https://api.duanz.xin:1217/v1
NEW_API_KEY=sk-xxxxx

# --- LLM（语义同步用）---
DHUB_LLM_MODEL=stepfun/step-3.7-flash

# --- Embedding（mem0 向量后端）---
DHUB_EMBED_MODEL=siliconflow/Qwen/Qwen3-Embedding-8B
DHUB_EMBED_DIMS=4096

# --- 记忆后端：mem0（向量）或 json（无向量，降级）---
DHUB_MEMORY_BACKEND=mem0

# --- mem0 用的 PostgreSQL（若用 mem0 后端）---
# POSTGRES_URI=postgresql://dhub:password@pgvector:5432/dhub
# PG_PASSWORD=changeme

# --- 鉴权：admin key（不设则鉴权关闭）---
# DHUB_ADMIN_KEY=admin-xxx

# --- 服务配置 ---
DHUB_PORT=10101
DHUB_HOST=0.0.0.0
